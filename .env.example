# =============================================================================
# IT Ops Dashboard
#
# Copy to .env and run `docker compose up`.
#
# EVERY INTEGRATION IS OPTIONAL. With this file copied verbatim and no keys
# filled in, the stack boots into a fully populated dashboard: Notion is served
# from bundled fixtures, summaries come from a deterministic mock summarizer, and
# Slack alerts are recorded as "skipped" instead of sent. Fill in the keys below
# to make each one real, one at a time.
#
# Setup walkthrough for the real keys: docs/SETUP-NOTION-SLACK.md
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=production
API_PORT=8080
WEB_PORT=3000
LOG_LEVEL=info

# Host the browser uses to reach the API. Leave as-is for local Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Consumed by the db service and the api/worker services.
POSTGRES_USER=itops
POSTGRES_PASSWORD=itops
POSTGRES_DB=itops
DATABASE_URL=postgres://itops:itops@db:5432/itops


# --- Notion ------------------------------------------------------------------
# Leave BOTH blank to run on api/fixtures/areas.json.
# Setting only one is rejected at boot -- that is a misconfiguration, not a fallback.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Pinned deliberately. Notion 2025-09-03 retires databases/:id/query in favour of
# data_sources/:id/query; this project has no use for multiple data sources per
# database, so it stays on the stable, well-documented endpoint.
NOTION_VERSION=2022-06-28


# --- AI ----------------------------------------------------------------------
# Leave LLM_API_KEY blank to use the built-in mock summarizer (no network calls).
#
# The default below is Groq: free, no credit card, and OpenAI-compatible, so the
# same code path serves OpenAI or any compatible gateway. Get a key at
# https://console.groq.com -> API Keys
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

LLM_MAX_TOKENS=300
# Low on purpose: this is extraction, not creative writing, and determinism makes
# the content-hash cache meaningful.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=30000

# --- OpenAI instead? Replace the three lines above with:
#   LLM_PROVIDER=openai-compatible
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
#
# --- Anthropic instead? Replace with:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-5
#   LLM_API_KEY=sk-ant-...
#   (LLM_BASE_URL is ignored for this provider)


# --- Slack -------------------------------------------------------------------
# Leave blank to disable sending. Status transitions are still recorded in the
# database and shown in the Activity feed, marked "skipped".
SLACK_WEBHOOK_URL=

# Alert fires only on a transition INTO one of these statuses.
SLACK_ALERT_STATUSES=At Risk,Blocked

# On the first sync every area is newly observed. Alerting then would fire once
# per area for a state nobody just changed, so it stays off.
ALERT_ON_FIRST_SEEN=false


# --- Sync loop ---------------------------------------------------------------
# The worker polls Notion on this interval. The dashboard also exposes a
# "Sync now" button that triggers a run immediately.
SYNC_INTERVAL_MS=60000
SYNC_ON_BOOT=true


# --- RAG chat (optional feature) ---------------------------------------------
RAG_ENABLED=true

# hash   -> zero-dependency deterministic embedder. Works offline, no model
#           download, no key. The default so the stretch feature is always live.
# local  -> all-MiniLM-L6-v2 via transformers.js. Real semantic retrieval, no key,
#           downloads ~90MB on first run.
# openai -> highest quality, requires EMBEDDING_API_KEY and a paid account.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Must match the vector(N) column in db/init.sql. Changing it means recreating
# the document_chunks table.
EMBEDDING_DIM=384

RAG_TOP_K=5
# Cosine similarity floor. If nothing clears it we answer "not in the indexed
# documents" without calling the LLM -- cheaper, and structurally prevents
# the model from answering from outside the corpus.
RAG_MIN_SCORE=0.35
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
